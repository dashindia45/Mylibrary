# ============================================
# Library Seat Booking Platform — Environment
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mylibrary

# ---------- Auth / JWT ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_EXPIRY_SECONDS=300
OTP_RATE_LIMIT_WINDOW_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---------- Email (Resend / SendGrid) ----------
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@mylibrary.in

# ---------- SMS / OTP (MSG91 / Twilio) ----------
SMS_PROVIDER=msg91
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=MYLIB
SMS_TEMPLATE_ID=your_template_id

# ---------- Application ----------
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Library Config ----------
LIBRARY_TIMEZONE=Asia/Kolkata

# ---------- Redis (for BullMQ background jobs) ----------
REDIS_URL=redis://localhost:6379

# ---------- File Uploads ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
